# Athena Pi Configuration

# Server Port
PORT=8000

# Download directory
# DOWNLOAD_DIR=/tmp/athena-downloads

# Max concurrent downloads
MAX_CONCURRENT_DOWNLOADS=2

# Password protection (optional)
# ATHENA_PASSWORD=your_secure_password_here

# Max file age in hours
MAX_FILE_AGE_HOURS=1.0

# Cleanup interval in seconds
CLEANUP_INTERVAL_SECONDS=600

# Logging level
RUST_LOG=info
